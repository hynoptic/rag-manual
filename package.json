{
  "name": "rag-manual",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:parse-worker": "pnpm --filter api worker:parse",
    "dev": "concurrently -n web,api,parse -c magenta,cyan,yellow \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:parse-worker\"",
    "rag": "pnpm --filter api exec tsx src/rag/dev.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
