{
  "name": "rag-manual",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev": "concurrently -n web,api -c magenta,cyan \"pnpm dev:web\" \"pnpm dev:api\"",
    "rag": "pnpm --filter api exec tsx src/rag/dev.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}